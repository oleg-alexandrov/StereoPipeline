"""
Run stereo on many image pairs given by an overlap list, and fuse the results.

Two modes:
  mesh:       pairwise stereo, then pc_filter, then a fused voxblox mesh. The cameras
              come from a rig (--rig_config, --camera_poses). This is the original
              behavior, for robot / structure-from-motion data with no datum.
  dem_mosaic: pairwise stereo on mapprojected images with the given cameras and a seed
              DEM, then per-pair point2dem, then a DEM mosaic and a maximum triangulation
              error mosaic. For mapprojected satellite images (for example CaSSIS). The
              tiled stereo stages of all pairs are pooled into one distributed job, so
              the load is balanced across all pairs at once, not one pair at a time.

Both modes read the image pairs from an overlap list (--overlap-list). Mode 'mesh' runs
the pairs in parallel, --processes at a time. Mode 'dem_mosaic' pools the per-tile work
of all pairs into one job of width --processes, spread over the $PBS_NODEFILE nodes if
that is set. --threads sets the threads per pair.
"""

import argparse, os, re, shutil, subprocess, sys, glob, shlex, tempfile
import numpy as np

