    # Mode 'dem_mosaic' has its own driver. It needs no rig or undistortion.
    if args.mode == "dem_mosaic":
        run_dem_mosaic(args, tool_base_dir)
        sys.exit(0)

    # Mode 'mesh' below.
    step_dict = STEP_DICTS["mesh"]
    sensors = args.rig_sensor.split()
    sensor_dir = "_".join(sensors) # for when there are multiple sensors

    # Read the images and camera poses
