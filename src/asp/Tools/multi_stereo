"""
Run stereo on many image pairs and fuse the results. A generalization of
parallel_stereo that load-balances the work across all pairs at once.

Both modes share the same stereo engine: the per-tile work of all pairs is pooled
into one job of width --processes, spread over the $PBS_NODEFILE nodes if that is set,
so the load is balanced across all pairs, not one pair at a time. --threads sets the
threads per pair. The modes differ only in how the per-pair clouds are fused:
  dem_mosaic: per-pair point2dem, then a DEM mosaic (and, with --errorimage /
              --orthoimage, a max triangulation error / orthoimage mosaic). Works for
              raw or mapprojected images (the latter with a seed DEM, --dem).
  mesh:       per-pair pc_filter, then a fused voxblox mesh. The cameras come from a
              rig (--rig-config, --camera-poses), for robot / structure-from-motion
              data with no datum.

The image pairs come from an overlap list (--overlap-list), or in dem_mosaic mode from
a convergence angle range (--conv-angle-prefix, --conv-angle-range).
"""

import argparse, os, re, shutil, subprocess, sys, glob, shlex, tempfile
import numpy as np

